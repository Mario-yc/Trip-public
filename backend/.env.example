APP_NAME="去哪玩AI 行程规划师"
APP_ENV=development
DATABASE_URL=sqlite:///./trip_demo.db
DEFAULT_USER_ID=local-demo-user
PROVIDER_MODE=mock

# DeepSeek Agent. DEEPSEEK_API_KEY is required for tool-calling Agent responses.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
AGENT_CONTROLLER_DECISION_TIMEOUT_SECONDS=10
AGENT_CONTROLLER_LITE_TIMEOUT_SECONDS=2.5
AGENT_CONTROLLER_TOTAL_BUDGET_SECONDS=12.5
# Server-authoritative initial planner profile. Keep strict_portfolio as the
# rollout default; set simple_open_v1 explicitly in test/development gates.
AGENT_INITIAL_PLANNING_MODE=strict_portfolio
AGENT_INTENT_ROUTING_MODE=active-all
SIMPLE_OPEN_COMPACT_RADIUS_METERS=5000
SIMPLE_OPEN_MAX_TRANSIT_LEG_MINUTES=45
SIMPLE_OPEN_QUALITY_FLOOR_RADIUS_METERS=8000
SIMPLE_OPEN_QUALITY_FLOOR_MAX_TRANSIT_LEG_MINUTES=60
SIMPLE_OPEN_MAX_BACKTRACK_RATIO=0.15
SIMPLE_OPEN_COMPACT_DETOUR_RATIO_THRESHOLD=0.15
SIMPLE_OPEN_ROUTE_PROVIDER_BUDGET=8
SIMPLE_OPEN_MAX_PAGES_PER_QUERY=3
DAILY_ROUTE_OVERLAP_POLICY=observe
# Opt in to proposal-only Creative Portfolio planning. When enabled, the user
# selects one persisted proposal before any itinerary version/patch is created.
AGENT_CREATIVE_PORTFOLIO_ENABLED=false
AGENT_CREATIVE_PORTFOLIO_TARGET_COUNT=4
# Initial comparison layout only; continuation can append up to the root-wide limits below.
AGENT_CREATIVE_PORTFOLIO_INITIAL_BATCH_SIZE=3
AGENT_CREATIVE_PORTFOLIO_MAX_VISIBLE_PROPOSALS=6
AGENT_CREATIVE_PORTFOLIO_MAX_GENERATED_PROPOSALS=12
AGENT_CREATIVE_PORTFOLIO_MAX_CONTINUATION_ROUNDS=6
AGENT_EXPERIENCE_GROUNDING_V2_MODE=enforce
AGENT_SOFT_SLOT_DRAFT_ADOPTION_ENABLED=true
AGENT_CREATIVE_OUTPUT_QUALITY_V2_MODE=enforce

# AMap WebService key is required for MVP POI grounding.
MAP_PROVIDER_KEY=

# AMap JS key/security code are used by the browser map surface.
MAP_JS_API_KEY=
MAP_PROVIDER_SECURITY_JS_CODE=
# Backward-compatible aliases also supported:
# AMAP_JS_API_KEY=
# AMAP_SECURITY_JS_CODE=
TICKET_PROVIDER_KEY=
VISIT_FACTS_MAX_AGE_HOURS=24
SOCIAL_SOURCE_MAX_AGE_HOURS=24
WEATHER_PROVIDER_KEY=
SEARCH_PROVIDER_KEY=

# Tool providers. Agent risk search defaults to free/no-key providers.
# Configure Tavily/Brave/SearXNG/Bocha only when explicitly opting into those providers.
# Failures return clear error metadata without mock search data.
WEB_SEARCH_PROVIDER_MODE=chain
WEB_SEARCH_PROVIDER=multi-free
WEB_SEARCH_PROVIDER_CHAIN=anysearch,ddgs,bing,duckduckgo,baidu,multi-free
WEB_SEARCH_API_KEY=
ANYSEARCH_API_KEY=

# AnySearch is enabled by default in the chain. It supports anonymous free access;
# API key raises the quota and concurrency limit. Keep tag empty for travel search.
ANYSEARCH_DOMAIN=travel
ANYSEARCH_TAG=
ANYSEARCH_ZONE=cn
ANYSEARCH_LANGUAGE=zh-CN
# system follows process HTTP(S)/ALL proxy settings; direct bypasses them only
# for AnySearch by using an empty urllib ProxyHandler.
ANYSEARCH_PROXY_MODE=auto
# Defaults to WEB_SEARCH_PROVIDER_TIMEOUT_SECONDS when omitted.
ANYSEARCH_TIMEOUT_SECONDS=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1:8080
DDGS_API_BASE_URL=http://127.0.0.1:4479
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
WEB_SEARCH_MIN_ACCEPTED_RESULTS=1
WEB_SEARCH_PROVIDER_TIMEOUT_SECONDS=5
WEB_SEARCH_MAX_PROVIDER_ATTEMPTS=6
# Shared wall-clock budget for one full provider-chain search.
WEB_SEARCH_CHAIN_DEADLINE_SECONDS=20
# Start optional DDGS local API with:
# .\scripts\start_free_search.ps1
# or: ddgs api --host 127.0.0.1 --port 4479
# If a local proxy is needed:
# ddgs api --host 127.0.0.1 --port 4479 -pr http://127.0.0.1:10793
# Optional proxy for free HTML search providers only. Keep empty unless needed.
WEB_SEARCH_PROXY_URL=
WEB_SEARCH_HTTP_PROXY=
DUCKDUCKGO_PROXY_URL=
DUCKDUCKGO_HTTP_PROXY=
BAIDU_PROXY_URL=
BAIDU_HTTP_PROXY=
BING_PROXY_URL=
BING_HTTP_PROXY=
AMAP_WEB_SERVICE_KEY=
# Dynamic named-boundary grounding. No city boundary identity or geometry is stored here.
NAMED_BOUNDARY_PROVIDER=osm_overpass
NAMED_BOUNDARY_OVERPASS_URL=https://overpass-api.de/api/interpreter
NAMED_BOUNDARY_TIMEOUT_SECONDS=8
NAMED_BOUNDARY_SIMPLIFICATION_MAX_DEVIATION_METERS=50
PROVIDER_TIMEOUT_SECONDS=8
FRONTEND_ORIGIN=http://localhost:5173
