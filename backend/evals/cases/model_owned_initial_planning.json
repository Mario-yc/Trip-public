      "deterministicBusinessPreemptionCount": 0,
      "plannerCalledOnHealthyControllerCount": 0,
      "timelineParserPreDecisionCount": 0,
      "legacyPhaseRouterPreemptionCount": 0,
      "deterministicInitialPlanUsedCount": 0,
      "executionRouteMismatchCount": 0,
      "genericToolLoopWithoutAcceptedDecisionCount": 0,
      "actionDirectiveModelCount": 3,
      "postObservationDecisionCount": 2,
