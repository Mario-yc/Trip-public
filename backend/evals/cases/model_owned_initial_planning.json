{
  "schemaVersion": "trip-agent-quality-scenarios-v1",
  "description": "Healthy model owns initial action and planning directive without deterministic semantic preemption.",
  "defaultMockMapProvider": {"enabled": true, "mockRouteRefresh": true, "trustedPoiFixtures": true},
  "scenarios": [{
