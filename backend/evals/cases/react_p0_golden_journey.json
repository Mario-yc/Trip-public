          "plannerFallbackWriteCount": 0,
          "genericToolLoopWithoutAcceptedDecisionCount": 0,
          "verifiedWriteCount": 1,
          "candidateSelectionPatchCount": 1,
          "candidateSelectionMustUseIdentity": true,
          "candidateSelectionChangedSegmentCount": 1,
          "falseSuccessClaimCount": 0,
          "transactionEvidenceMissingCount": 0,
          "durationPreservationFailureCount": 0,
          "executionRouteMismatchCount": 0,
          "routeStatusEventSnapshotMismatch": false,
          "mealCostPerPersonMismatchCount": 0,
          "fallbackChoiceVersionDelta": 0,
          "maxWebSearchCalls": 0,
          "maxTicketLookupCalls": 0,
          "maxAmapWeatherCalls": 0
        }
