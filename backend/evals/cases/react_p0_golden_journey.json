      "expectations": {
        "turnCount": 2,
        "seededItineraryCount": 0,
        "turn1CreatedActiveVersionCount": 1,
        "preControllerDomainRouterCount": 0,
        "localMutationBypassCount": 0,
        "plannerFallbackWriteCount": 0,
        "genericToolLoopWithoutAcceptedDecisionCount": 0,
        "falseSuccessClaimCount": 0,
