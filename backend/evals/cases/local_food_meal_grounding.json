  "steps": [
    { "action": "create_session", "saveAs": "session", "payload": { "city": "北京", "title": "北京本地美食 Eval" } },
    {
      "action": "send_agent_message",
      "saveAs": "first",
      "sessionIdFrom": "session.sessionId",
      "content": "2026年10月1日，北京一日游，1天，中等预算，1人，公交地铁优先。午餐和晚餐都想体验当地特色美食，晚上看夜景。",
      "context": { "selectedDayNumber": 1 }
    }
  ],
  "assertions": [
    { "path": "first.statusCode", "equals": 200 },
    { "path": "first.version", "exists": true },
    { "path": "first.itinerary.days[].segments[].kind", "contains": "meal" },
    { "path": "first.itinerary.days[].segments[].poi.source", "contains": "amap-place-search" },
    { "path": "first.itinerary.days[].segments[].poi.amapId", "contains": "AMAP_LOCAL_FOOD_LUNCH" },
    { "path": "first.itinerary.days[].segments[].poi.amapId", "contains": "AMAP_LOCAL_FOOD_DINNER" },
    { "path": "first.itinerary.days[].segments[].poi.name", "notContainsAny": ["SERVER_GENERIC_DAY_SLOT_FALLBACK", "provider_call_error", "semantic_candidate_hint_missing", "北京本地菜餐厅", "北京特色小吃馆", "北京老字号餐厅", "北京家常菜馆"] },
    { "path": "first.itinerary.days[].segments[].poi.amapId", "notContainsAny": ["mock_amap_"] },
    { "path": "first.itinerary.days[].segments[].poi.sourceNote", "notContainsAny": ["CLI eval mock", "mock AMap candidate", "not a real map POI"] },
    { "path": "first.pendingPoiCandidates", "lengthEquals": 0 }
  ],
  "expect": {
    "invalidPatchCount": 0,
    "replayStages": ["normalize_request", "initial_day_slot_provider", "generate_day_slots", "decompose_intent_pools", "collect_candidates", "build_persistable_segment_plans", "create_itinerary_version", "basic_verifier", "deterministic_enrichment"],
    "allowedFailedStages": ["basic_verifier"]
  }
