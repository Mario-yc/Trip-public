  "steps": [
    {
      "action": "create_session",
      "saveAs": "session",
      "payload": { "city": "北京", "title": "Simple Open guide grounded continuation Eval" }
    },
    {
      "action": "send_agent_message",
      "saveAs": "first",
      "sessionIdFrom": "session.sessionId",
      "content": "10月1日北京一日游，想参观高校并逛城市公园。中等预算，1人，公交地铁优先。",
      "context": { "selectedDayNumber": 1 }
    },
    {
      "action": "send_selected_agent_choice",
      "saveAs": "second",
      "sessionIdFrom": "session.sessionId",
      "sourceFrom": "first",
      "choiceAction": "continue_plan_expansion",
      "choiceKind": "simple_direction_more_plans",
      "content": "继续生成另一个不重复的方案"
    },
    {
      "action": "send_selected_agent_choice",
      "saveAs": "guide",
      "sessionIdFrom": "session.sessionId",
      "sourceFrom": "second",
      "choiceAction": "search_travel_guide_advice",
      "choiceKind": "travel_guide_advice",
      "content": "搜索普通攻略并给我建议"
    },
    {
      "action": "send_agent_message",
      "saveAs": "third",
      "sessionIdFrom": "session.sessionId",
      "content": "参考攻略建议的地点，生成新的方案"
    },
    {
      "action": "db_query",
      "saveAs": "counts",
      "query": "SELECT (SELECT COUNT(*) FROM agent_plan_proposals) AS proposal_count, (SELECT COUNT(DISTINCT portfolio_id) FROM agent_plan_proposals) AS portfolio_count, (SELECT COUNT(*) FROM itinerary_versions) AS version_count, (SELECT COUNT(*) FROM itinerary_patches) AS patch_count, (SELECT COUNT(*) FROM route_options) AS route_count, (SELECT COUNT(*) FROM agent_choice_executions WHERE action = 'continue_plan_expansion' AND status = 'succeeded') AS continuation_exec_count, (SELECT COUNT(*) FROM agent_choice_executions WHERE action = 'search_travel_guide_advice' AND status = 'succeeded') AS guide_choice_exec_count"
    },
    {
      "action": "db_query",
      "saveAs": "proposalEvidence",
      "query": "SELECT evidence_json, json_extract(evidence_json, '$.guideEvidenceUsage.schemaVersion') AS usage_schema, json_extract(evidence_json, '$.guideEvidenceUsage.status') AS usage_status, json_extract(evidence_json, '$.guideEvidenceUsage.sourceReadSummary.readableCount') AS readable_count FROM agent_plan_proposals ORDER BY created_at DESC LIMIT 1"
    },
    {
      "action": "db_query",
      "saveAs": "sourceReads",
      "query": "SELECT COUNT(*) AS readable_count FROM agent_choice_executions AS e, json_each(e.continuation_json, '$.guideContinuationRequirement.sourceDocumentEvidence.documents') AS d WHERE json_extract(d.value, '$.status') = 'succeeded' AND json_extract(d.value, '$.contentKind') = 'article'"
    },
    {
      "action": "db_query",
      "saveAs": "thirdAudit",
      "query": "SELECT agent_request_json, agent_response_json FROM conversation_turns WHERE role = 'assistant' ORDER BY turn_index DESC LIMIT 1"
    }
  ],
  "assertions": [
    { "path": "first.statusCode", "equals": 200 },
    { "path": "first.version", "isNull": true },
    { "path": "first.assistantTurn.choiceOptions[].action", "contains": "search_travel_guide_advice" },
    { "path": "guide.statusCode", "equals": 200 },
    { "path": "guide.version", "isNull": true },
    { "path": "guide.assistantTurn.guideAdvice.status", "equals": "completed" },
    { "path": "guide.assistantTurn.choiceOptions[].action", "contains": "continue_plan_expansion" },
    { "path": "second.statusCode", "equals": 200 },
    { "path": "second.version", "isNull": true },
    { "path": "second.assistantTurn.choiceOptions[].action", "contains": "search_travel_guide_advice" },
    { "path": "third.statusCode", "equals": 200 },
    { "path": "third.version", "isNull": true },
    { "path": "sourceReads", "allFieldEquals": { "readable_count": 2 } },
    {
      "path": "third.assistantTurn.comparisonProjections",
      "lengthAtLeast": 1
    },
    { "path": "third.assistantTurn.choiceOptions[].action", "contains": "select_plan_proposal" },
    {
      "path": "counts",
      "allFieldEquals": {
        "proposal_count": 3,
        "portfolio_count": 1,
        "version_count": 0,
        "patch_count": 0,
        "route_count": 0,
        "continuation_exec_count": 2,
        "guide_choice_exec_count": 1
      }
    },
    {
      "path": "proposalEvidence",
      "allFieldContains": {
        "evidence_json": "\"guideEvidenceUsage\":{"
      }
    },
    {
      "path": "proposalEvidence",
      "allFieldEquals": {
        "usage_schema": "guide-evidence-usage-v1",
        "usage_status": "satisfied",
        "readable_count": 2
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_request_json": "\"guideContinuationRequirement\": {\"schemaVersion\": \"guide-continuation-requirement-v1\""
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_request_json": "\"minimumNovelGroundedPlaceCount\": 1"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"proposalDelta\": 1"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"guideEvidenceUsage\": {"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"schemaVersion\": \"guide-evidence-usage-v1\", \"status\": \"satisfied\""
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"agent_stop\""
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"plannerCalled\": true"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"controllerFullCallCount\": 1"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"controllerLiteCallCount\": 0"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"intentProviderCallCount\": 1"
      }
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {"agent_response_json": "\"semanticActionCallCount\": 1"}
    },
    {
      "path": "thirdAudit",
      "allFieldContains": {
        "agent_response_json": "\"fallbackControllerLiteCallCount\": 0"
      }
    }
  ],
