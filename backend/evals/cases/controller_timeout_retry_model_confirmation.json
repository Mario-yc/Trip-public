{
  "schemaVersion": "trip-agent-quality-scenarios-v1",
  "description": "Controller 超时后用户选择重试；重试轮仅调用一次恢复后的 Controller。",
  "scenarios": [{
    "id": "controller_timeout_retry_model_confirmation",
    "city": "北京",
    "turns": [
      {"input": "10月1日北京一日游，参观大学和美术馆，中等预算，1人，公交地铁优先。", "mockMapProvider": {"enabled": true, "trustedPoiFixtures": true, "mockRouteRefresh": true, "controllerFailure": "timeout"}},
      {"input": "重试模型规划", "selectedAgentChoiceAction": "retry_model_planning", "mockMapProvider": {"enabled": true, "trustedPoiFixtures": true, "mockRouteRefresh": true}}
    ],
    "turnExpectations": [
      {"terminalStatus": "needs_confirmation", "controllerFallbackCount": 1},
      {"terminalStatus": "needs_confirmation", "controllerRetryCount": 1, "choiceConsumedCount": 1, "ruleSafeDraftConfirmedCount": 0, "verifiedWriteCount": 1, "rollbackCount": 0}
    ],
    "expectations": {"turnCount": 2, "controllerRetryCount": 1, "choiceConsumedCount": 1, "ruleSafeDraftConfirmedCount": 0, "repeatedSameClarificationCount": 0}
  }]
}
